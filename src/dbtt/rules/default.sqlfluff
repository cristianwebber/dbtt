# dbtt default sqlfluff ruleset.
#
# This is the opinionated baseline dbtt applies when a project has no .sqlfluff
# of its own. If the project *does* have a .sqlfluff, dbtt steps aside and lets
# sqlfluff use it instead — this file is never merged on top of a user config.
#
# Style decisions baked in here:
#   - leading commas
#   - keywords UPPERCASE; functions, data types, and literals lowercase
#   - 120-char lines, 4-space indentation
#   - explicit AS for column and table aliases
#   - columns qualified in multi-table queries
#   - GROUP BY / ORDER BY reference column names, not positions
#
# The dialect is intentionally NOT set here — dbtt supplies it at runtime
# (auto-detected from the dbt profile, or via --dialect) so the same ruleset
# works for every warehouse, not just one.

[sqlfluff]
templater = jinja
max_line_length = 120

# The jinja templater resolves dbt's ref()/source()/config()/var() as builtins
# so models lint offline without a warehouse connection.
[sqlfluff:templater:jinja]
apply_dbt_builtins = true

[sqlfluff:indentation]
tab_space_size = 4
indent_unit = space

# Leading commas.
[sqlfluff:layout:type:comma]
line_position = leading

# Casing.
[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower

# Require explicit AS for aliases.
[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

# GROUP BY / ORDER BY must use column names, not positional numbers.
[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = explicit
